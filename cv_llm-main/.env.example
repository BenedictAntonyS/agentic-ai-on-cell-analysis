# NeuroCell GAN & Multimodal VLM Suite Environment Configuration
# Copy this file to .env and insert your personal API keys (never commit .env to source control).

# Optional Groq Cloud API Key (for Multimodal VLM image understanding and Dr. NeuroCell AI Copilot)
# Obtain a free-tier key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Optional: Default VLM Vision Model ID
# Supported vision models on Groq:
# - llama-3.2-11b-vision-preview (recommended default, fast & free tier eligible)
# - llama-3.2-90b-vision-preview (larger model)
# - qwen/qwen3.6-27b
DEFAULT_VISION_MODEL=llama-3.2-11b-vision-preview

# Optional: Default Text Copilot Model ID
DEFAULT_TEXT_MODEL=llama-3.3-70b-versatile

# Note: Core Computer Vision processing, Otsu/Watershed segmentation, temporal region tracking,
# and 200-epoch ConvLSTM GAN forecasting run 100% LOCALLY without any API key or external network access.
